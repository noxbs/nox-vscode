project "nox-language-support" {
    version = file("./VERSION")
    description = "Syntax highlighting and live diagnostics for Nox files in Visual Studio Code."
    license = "Unlicense"
    version_files = ["VERSION"]

    executable.javascript "nox-language-support" {
        sources = [
            "src/extension.js",
            "src/lint/index.js",
            "src/lint/build.js",
        ]
    }
}